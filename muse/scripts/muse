#!/usr/bin/env bash
# Hand a task to a worker model through opencode headless.
# Claude Code stays the orchestrator: it writes the spec file, this runs the worker.
set -euo pipefail

MODEL="${MUSE_MODEL:-opencode/muse-spark-1.3-contributor-free}"
VARIANT="${MUSE_VARIANT:-xhigh}"
DIR="$PWD"
CONT=()
AGENT=(--agent build)
AUTO=(--auto)
FORK=()
FORMAT=()
FILES=()

usage() {
  cat <<'USAGE'
usage: muse [options] SPEC_FILE
       muse [options] -m "inline prompt"
       muse --list [PROVIDER]

options:
  --dir PATH        repo to work in (default: current directory)
  -c, --continue    continue the last muse session in that repo
  -s, --session ID  continue a specific session id
  --fork            fork the session instead of extending it (with -c or -s)
  --plan            read-only planning agent instead of build
  --agent NAME      any other opencode agent by name
  --model NAME      worker model, provider/model (env: MUSE_MODEL)
  --variant NAME    reasoning effort: minimal low medium high xhigh, or
                    none for a model that has no variants (env: MUSE_VARIANT)
  --no-auto         ask before each file write and shell command
  -f, --file PATH   attach a file to the message, repeatable
  --json            raw JSON events instead of formatted output
  --list [PROV]     list the models opencode can reach, then exit
  -m, --message     treat the next argument as the prompt, not a file path

Defaults: opencode/muse-spark-1.3-contributor-free at variant xhigh, which is
free on the opencode contributor tier. Any model from `muse --list` works.

The spec file route is the safe one. A shell never sees the prompt text, so a
backtick, a $ or a ! inside the spec reaches the model intact.
USAGE
}

MSG=""
SPEC=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) DIR="$2"; shift 2 ;;
    -c|--continue) CONT=(--continue); shift ;;
    -s|--session) CONT=(--session "$2"); shift 2 ;;
    --fork) FORK=(--fork); shift ;;
    --plan) AGENT=(--agent plan); shift ;;
    --agent) AGENT=(--agent "$2"); shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    --variant) VARIANT="$2"; shift 2 ;;
    --no-auto) AUTO=(); shift ;;
    -f|--file) FILES+=(-f "$2"); shift 2 ;;
    --json) FORMAT=(--format json); shift ;;
    --list) shift; exec opencode models ${1:+"$1"} ;;
    -m|--message) MSG="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) SPEC="$1"; shift ;;
  esac
done

if [ "$VARIANT" = "none" ]; then VARIANT=""; fi

if [ -z "$MSG" ]; then
  if [ -z "$SPEC" ]; then usage; exit 2; fi
  if [ ! -f "$SPEC" ]; then echo "muse: no such spec file: $SPEC" >&2; exit 2; fi
  MSG="$(cat "$SPEC")"
fi

exec opencode run \
  --dir "$DIR" \
  -m "$MODEL" \
  ${VARIANT:+--variant "$VARIANT"} \
  "${AGENT[@]}" \
  ${CONT[@]+"${CONT[@]}"} \
  ${FORK[@]+"${FORK[@]}"} \
  ${FILES[@]+"${FILES[@]}"} \
  ${FORMAT[@]+"${FORMAT[@]}"} \
  ${AUTO[@]+"${AUTO[@]}"} \
  -- "$MSG"
